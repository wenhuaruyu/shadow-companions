{
  "name": "anxian-together-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "暗线同行者 两地移动横屏双人联网体验版",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @anxian/web",
    "dev:server": "npm run start:v2 --workspace @anxian/server",
    "check": "node scripts/check.mjs",
    "start": "npm run start:v2 --workspace @anxian/server",
    "test": "node --test apps/server/test/*.test.js apps/web/test/*.test.js",
    "dev:legacy": "npm run dev --workspace @anxian/server",
    "start:legacy": "node apps/server/src/index.js",
    "test:web": "npm test --workspace @anxian/web",
    "test:db": "npm run test:db --workspace @anxian/server",
    "build": "npm run build --workspace @anxian/web",
    "db:migrate": "npm run db:migrate --workspace @anxian/server"
  },
  "engines": {
    "node": ">=24"
  }
}
