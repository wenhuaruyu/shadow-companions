PORT=3000
HOST=0.0.0.0
WEB_PORT=5173

# 第二阶段独立入口，复制到部署环境变量，勿提交真实凭证
PUBLIC_ORIGIN=https://game.example.com
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=game_app
DB_PASSWORD=
DB_NAME=anxian_game

# 按控制台要求启用TLS，DB_CA可提供可信CA内容
DB_SSL=true
DB_CA=

# CloudBase HTTP RPC接入，服务端凭证由环境配置提供
STORAGE_MODE=pg
RPC_ENDPOINT=https://YOUR_ENV.api.tcloudbasegateway.com/v1/rdb/rest/rpc
RPC_SERVICE_TOKEN=

# 前端开发服务器代理；前后端共用同源 /api
API_TARGET=http://127.0.0.1:3000
WEB_HOST=127.0.0.1
